---
layout: null
---
[
{% assign tr_posts = site.posts | where: "lang", "tr" %}
{% for post in tr_posts %}
  {% capture post_date %}{% include date-i18n.html date=post.date lang="tr" %}{% endcapture %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "desc": {{ post.description | jsonify }},
    "date": {{ post_date | strip | jsonify }},
    "logo": {{ post.logo | relative_url | jsonify }},
    "category": {{ post.categories | first | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
