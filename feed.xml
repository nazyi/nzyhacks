---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="tr">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" hreflang="tr" />
  <link href="{{ '/en/' | absolute_url }}" rel="alternate" type="text/html" hreflang="en" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <title type="html">nzyhacks</title>
  <subtitle>{{ site.description }}</subtitle>
  {% assign tr_posts = site.posts | where: "lang", "tr" | sort: "date" | reverse %}
  {% for post in tr_posts limit: 20 %}
  <entry xml:lang="tr">
    <title type="html">{{ post.title | smartify | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url }}"><![CDATA[{{ post.content }}]]></content>
    {% if post.author %}
    <author>
      <name>{{ post.author }}</name>
    </author>
    {% endif %}
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}" />
    {% endfor %}
    {% for category in post.categories %}<category term="{{ category | xml_escape }}" />
    {% endfor %}
  </entry>
  {% endfor %}
</feed>
